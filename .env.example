# PostgreSQL (Neon)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require


# API (Google Cloud Run locally / deployed)
PORT=8000
NODE_ENV=development
BASE_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000

# Web (Vercel)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=false

# Secrets (min 32 characters in production)
JWT_SECRET=replace-with-openssl-rand-base64-32
CSRF_SECRET=replace-with-openssl-rand-base64-32

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Optional legacy Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# Demo login for judges (API only)
ENABLE_DEMO_LOGIN=false

# Email (Phase 5)
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
